.env*
*.env
!*.example

# Language manifests must be committed — they are what makes a directory a
# discoverable extension implementation (scripts glob */language.env). The
# broad *.env rule above would otherwise swallow them and a fresh clone would
# find no languages at all.
!language.env
!*/language.env

# Coston/Coston2 proxy configs (contain DB credentials)
config/proxy/extension_proxy.coston.toml
config/proxy/extension_proxy.coston.docker.toml
config/proxy/extension_proxy.coston2.toml
config/proxy/extension_proxy.coston2.docker.toml
config/proxy/extension_proxy.songbird.toml
config/proxy/extension_proxy.songbird.docker.toml
config/proxy/extension_proxy.flare.toml
config/proxy/extension_proxy.flare.docker.toml
config/extension.env
out/
cache/
.DS_Store

# go.work is generated on demand by start-services.sh for USE_LOCAL_SIBLINGS=1
# (points host builds at sibling tee-node / tee-proxy). Never committed.
go.work
go.work.sum

# Compiled Go binaries
tools/start-*
tools/allow-*
tools/deploy-*
tools/register-*
tools/run-*
tools/verify-*
tools/query-*
tools/set-*
tools/audit-*
tools/test-*

# Generated contract bindings (produced by scripts/generate-bindings.sh)
tools/pkg/contracts/*/autogen.go
tools/pkg/contracts/*/*.abi
tools/pkg/contracts/*/*.bin

# Language implementation build artifacts.
# package-lock.json is deliberately NOT ignored — it is the reproducibility
# anchor for `npm ci` in typescript/Dockerfile.
typescript/node_modules/
typescript/dist/
python/__pycache__/
python/**/__pycache__/
python/.venv/
python/.pytest_cache/
**/*.pyc

docs/superpowers

notes/

# Private deployment guide (SSH, redeploy instructions)
DEPLOYMENT.md

config/**/*.log
# Per-chain one-shot registration state written by register-tee — machine-local.
config/**/*.state